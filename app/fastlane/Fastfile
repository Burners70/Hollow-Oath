# Build & release lanes for Hollow Oath.
#
# Every lane that produces an app runs the web sync FIRST — mirroring the repo
# root into app/www (which stamps BUILD_TAG with the bundled content's hash) and
# copying it into the native shell. This makes it impossible for a fastlane build
# to ship stale JS: the "updated HOW TO FLY / first-play fork missing from the
# native build" report happened because app/www is a generated copy and syncing
# it was a manual step that could be skipped before archiving.
#
# Run from app/:
#   bundle exec fastlane build   # sync + signed App Store archive (no upload)
#   bundle exec fastlane beta    # ...+ upload to TestFlight (needs auth, see below)
#
# UPLOAD IS MANUAL for now. The current release path archives + uploads in Xcode
# (Product → Archive → Distribute App → App Store Connect), because Xcode handles
# Apple ID sign-in / 2FA interactively. The `beta` lane's `upload_to_testflight`
# needs an App Store Connect API key or an app-specific password
# (FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD) — without it altool fails with
# "-22910 Please sign in with an app-specific password". `sync_web` and `build`
# work today; use them to produce a fresh, correctly-stamped archive, then upload
# from Xcode. See app/MAC_SETUP.md §2 "Building for TestFlight".
#
# These lanes do NOT run `pod install`; they assume pods are already installed
# (setup-mac.sh / `npm run sync` handle that). Run those once after cloning or
# after native-dependency changes.

default_platform(:ios)

WORKSPACE = "ios/App/App.xcworkspace"
SCHEME    = "App"

# app/ — the parent of this fastlane/ dir; where sync.sh and capacitor.config.ts
# live. Resolved absolutely so it holds regardless of fastlane's working dir.
APP_DIR = File.expand_path("..", __dir__)

platform :ios do
  desc "Mirror the web game into the native shell (never edit app/www by hand)"
  lane :sync_web do
    # ./sync.sh mirrors the repo root -> app/www (and stamps BUILD_TAG); `cap copy`
    # pushes www -> the native shell's public/. We use `cap copy`, NOT `cap sync`
    # (i.e. not `npm run sync`), on purpose: `sync` also runs `pod install`, which
    # fails under `bundle exec` because Bundler hides Homebrew's `pod` from the
    # environment — and refreshing web assets never needs a native-dependency
    # reinstall. If plugins/native deps ever change, run `npm run sync` once
    # outside fastlane (a plain terminal, where CocoaPods is on PATH).
    sh("cd '#{APP_DIR}' && ./sync.sh && npx cap copy ios")
  end

  desc "Build a signed App Store archive (syncs the web build first)"
  lane :build do
    sync_web
    build_app(workspace: WORKSPACE, scheme: SCHEME, export_method: "app-store")
  end

  desc "Build + upload to TestFlight (NEEDS App Store Connect API key / app-specific password — see header; upload is manual in Xcode until then)"
  lane :beta do
    sync_web
    build_app(workspace: WORKSPACE, scheme: SCHEME, export_method: "app-store")
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end
end
